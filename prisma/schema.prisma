generator client {
  provider     = "prisma-client"
  output       = "../api/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Subscriber {
  id               String           @id @default(cuid())
  email            String           @unique
  status           SubscriberStatus @default(CONFIRMED)
  unsubscribeToken String           @unique @default(cuid())
  createdAt        DateTime         @default(now())
}

enum SubscriberStatus {
  CONFIRMED
  UNSUBSCRIBED
}
